# =============================================================================
# erp-staging environment - copy to /home/user/erp-staging/.env, chmod 600.
# NO REAL SECRETS IN THIS FILE. Generate every secret fresh:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# deploy.sh refuses to run if any secret below equals production's
# (~/zchpc-erp/.env) or the old staging stack's (~/zchpc-erp-staging/.env).
# =============================================================================

# --- identity of this stack (deploy.sh / seed-eval.sh refuse anything else) ---
COMPOSE_PROJECT_NAME=erp-staging
ZCHPC_ENV=staging

# --- database (staging-only names; must differ from production's) ---
POSTGRES_DB=erp_staging
POSTGRES_USER=erp_staging
POSTGRES_PASSWORD=__generate__

# --- Django ---
SECRET_KEY=__generate__
# Hostnames the staging API answers to. Never '*', never production domains.
# localhost/127.0.0.1 are required by the image's built-in healthcheck.
STAGING_HOSTS=localhost,127.0.0.1,10.50.14.12,erp-staging.zchpc.ac.zw,employees-staging.zchpc.ac.zw
# Browser origins of the staging frontends (CORS + CSRF). Never production origins.
STAGING_ORIGINS=https://erp-staging.zchpc.ac.zw,https://employees-staging.zchpc.ac.zw,http://10.50.14.12:13000,http://10.50.14.12:13001
# Number of reverse proxies in front of the API (1 when behind cPanel).
DRF_NUM_PROXIES=0
# JWT lifetimes. Empty = defaults (access 1 day, refresh 30 days). For the
# AUTH-1 expiry test set a short access token, e.g. 2, then reset to empty.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
JWT_REFRESH_TOKEN_LIFETIME_DAYS=

# --- API origins baked into the frontend bundles at build time (VITE_API_URL) ---
# Origin only, no /api suffix. The bundle guardrail requires each to be
# present in its bundle and production origins to be absent.
# LAN fallback (no cPanel): both http://10.50.14.12:18000
STAGING_FRONTEND_API_ORIGIN=https://erp-staging.zchpc.ac.zw
STAGING_PORTAL_API_ORIGIN=https://employees-staging.zchpc.ac.zw

# --- images (built off the VM and loaded with `docker load`; never :latest) ---
API_IMAGE=erp-staging/api:__sha__
FRONTEND_IMAGE=erp-staging/frontend:__sha__
PORTAL_IMAGE=erp-staging/portal:__sha__

# --- host ports (must not be 8000/3000/3001/5432/5440) ---
STAGING_API_PORT=18000
STAGING_FRONTEND_PORT=13000
STAGING_PORTAL_PORT=13001
